{
  "expo": {
    "name": "Hospital",
    "slug": "Hospital-Mobile",
    "version": "1.0.0",
    "scheme": "hospital-mobile",
    "orientation": "portrait",
    "icon": "./assets/images/hospital.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hospital.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/hospital.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-camera", "expo-notifications"],
    "extra": {
      "eas": {
        "projectId": "09db609d-4c49-454d-89aa-8b9114ea463a"
      }
    }
  }
}
